# Cloudflare Pages headers file
# https://developers.cloudflare.com/pages/configuration/headers/

# RFC 8288 Link headers for agent/automated discovery on the homepage
/
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </feed.xml>; rel="alternate"; type="application/rss+xml"; title="VNTechies Dev Blog RSS"
  Link: </robots.txt>; rel="describedby"; type="text/plain"

# Same Link headers for all blog post pages
/blog/*
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </feed.xml>; rel="alternate"; type="application/rss+xml"; title="VNTechies Dev Blog RSS"

# Long cache for content-hashed build assets (safe: filename changes on every build)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static images/fonts/favicons: a week (filenames are stable, so keep it modest)
/static/*
  Cache-Control: public, max-age=604800


